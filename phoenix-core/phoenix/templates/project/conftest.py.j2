def pytest_bdd_step_error(request, feature, scenario, step, exception, **kwargs):
    """Translate step failures into plain English and capture a screenshot."""
    try:
        from phoenix.execution.failure_reporter import record_step_failure
        page = request.getfixturevalue("page") if "page" in request.fixturenames else None
        record_step_failure(
            feature=feature,
            scenario=scenario,
            step=step,
            exception=exception,
            page=page,
        )
    except Exception:
        pass  # never let reporting break the test run


