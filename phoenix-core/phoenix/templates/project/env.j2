# Environment variables for {{ project_name }}
# Copy this file to .env.local and fill in real values.
# Generated conftest.py loads .env.local from the project root before reading settings.
# Values in .env.local override shell variables, regardless of the working directory.
# Precedence: .env.local, then shell variables, then this .env file.
# NEVER commit .env.local to version control.

APP_URL={{ base_url }}
# Add only the credential variables explicitly referenced by your reviewed tests.
# PHOENIX_AUTH_STORAGE_STATE=.phoenix/your-reviewed-storage-state.json

PHOENIX_BROWSER={{ browser }}
PHOENIX_LOG_LEVEL=INFO
# ANTHROPIC_API_KEY=

# ---------------------------------------------------------------------------
# Jira integration (optional)
# Get your API token at: https://id.atlassian.com/manage-profile/security/api-tokens
# Also enable [jira] section in .phoenixrc with your instance URL and project key.
# ---------------------------------------------------------------------------
# JIRA_URL=https://yourcompany.atlassian.net
# JIRA_EMAIL=your.email@company.com
# JIRA_API_TOKEN=your_jira_api_token_here
