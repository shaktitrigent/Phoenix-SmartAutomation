"""Authentication fixtures using an explicitly supplied browser storage state.

Create the state through the application's reviewed login flow. This scaffold
never guesses login selectors or credential environment-variable names.
"""
from __future__ import annotations
import json
import os
from pathlib import Path
import pytest
from playwright.sync_api import Browser, BrowserContext, Page


@pytest.fixture(scope="session")
def auth_storage_state() -> dict:
    configured = os.environ.get("PHOENIX_AUTH_STORAGE_STATE", "").strip()
    if not configured:
        raise pytest.UsageError("Supply PHOENIX_AUTH_STORAGE_STATE from a reviewed login flow")
    path = Path(configured)
    if not path.is_absolute():
        path = Path(__file__).resolve().parents[1] / path
    try:
        state = json.loads(path.read_text(encoding="utf-8"))
    except (OSError, ValueError) as exc:
        raise pytest.UsageError("Cannot read the supplied authentication storage state") from exc
    if not isinstance(state, dict) or not isinstance(state.get("cookies"), list) or not isinstance(state.get("origins"), list):
        raise pytest.UsageError("Authentication state must contain cookies and origins lists")
    return state


@pytest.fixture(scope="session")
def authenticated_context(browser: Browser, auth_storage_state: dict) -> BrowserContext:
    ctx = browser.new_context(storage_state=auth_storage_state)
    ctx.set_default_timeout(30_000)
    ctx.set_default_navigation_timeout(60_000)
    try:
        yield ctx
    finally:
        ctx.close()


@pytest.fixture
def authenticated_page(authenticated_context: BrowserContext) -> Page:
    page = authenticated_context.new_page()
    try:
        yield page
    finally:
        page.close()
